generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  SELLER
  CUSTOMER
}

enum VerificationCodeType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

enum SaleStatus {
  ACTIVE
  REVERTED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          UserRole
  emailVerified Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile     SellerProfile?
  customerProfile   CustomerProfile?
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  categories        Category[]
  products          Product[]
  sales             Sale[]             @relation("SellerSales")
  purchases         Sale[]             @relation("CustomerSales")

  @@map("users")
}

model SellerProfile {
  id                 String  @id @default(uuid())
  companyName        String
  sellerName         String
  sellerLastName     String
  companyType        String
  companyDescription String?
  address            String?
  hoursOfOperation   Json?
  contactNumber      String
  // USD → bolívar rate this seller prices with. Sales snapshot it at checkout.
  customTaxRate      Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@map("seller_profiles")
}

model CustomerProfile {
  id            String @id @default(uuid())
  firstName     String
  lastName      String
  contactNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  @@map("customer_profiles")
}

model Category {
  id   String @id @default(uuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String

  products Product[]

  // A seller cannot have two categories with the same name; different sellers can.
  @@unique([sellerId, name])
  @@index([sellerId])
  @@map("categories")
}

model Product {
  id       String  @id @default(uuid())
  name     String
  price    Decimal @db.Decimal(12, 2)
  quantity Int     @default(0)

  // Products are archived, never deleted: a sold product must keep existing so
  // its sale lines stay readable and a revert can restore its stock.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Detaches rather than cascades, for the same reason a sale does: a sold
  // product is pinned by SaleItem's Restrict FK, so cascading here would make
  // the owning user undeletable. An orphaned product is invisible to every
  // query (they all scope by a real sellerId) and is reaped once nothing
  // references it — see SaleCleanupService.
  seller   User?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId String?

  // Deleting a category keeps its products, they just become uncategorized.
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?

  saleItems SaleItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@map("products")
}

model Sale {
  id     String     @id @default(uuid())
  status SaleStatus @default(ACTIVE)
  // Snapshots taken at checkout: the line total, and the rate it was sold at.
  // Neither may be recomputed later — prices and the rate both move.
  totalUsd     Decimal   @db.Decimal(12, 2)
  exchangeRate Decimal?  @db.Decimal(12, 2)
  revertedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Both sides detach rather than cascade: a sale is a financial record that
  // outlives the accounts on it. The row is only removed once BOTH are null
  // (see SaleCleanupService) — deleting a user must never erase history the
  // other party still needs.
  seller   User?   @relation("SellerSales", fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId String?

  // Always null for now; the column exists so sales can be attributed later.
  customer   User?   @relation("CustomerSales", fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?

  items SaleItem[]

  @@index([sellerId])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id       String @id @default(uuid())
  quantity Int
  // What was actually charged, and what the product was called at the time.
  unitPrice   Decimal @db.Decimal(12, 2)
  productName String

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId String

  // Restrict is what forces products to be archived instead of deleted.
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId String

  @@unique([saleId, productId])
  @@index([productId])
  @@map("sale_items")
}

model VerificationCode {
  id        String               @id @default(uuid())
  code      String
  type      VerificationCodeType
  expiresAt DateTime
  used      Boolean              @default(false)

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, type])
  @@map("verification_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("refresh_tokens")
}
